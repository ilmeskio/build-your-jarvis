# We keep this file committed so everyone in the workshop starts from the same defaults.
# Copy this to .env and customize as needed.

# We pin the image so the workshop behaves consistently across machines.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.0.2

# We keep the port stable so the tunnel command and docs stay simple.
N8N_PORT=5678

# We set a timezone so scheduled workflows behave predictably across laptops.
N8N_TIMEZONE=UTC

# This will be automatically set by scripts/start-tunnel.sh when you run the tunnel.
# For Cloudflare Quick Tunnels, the hostname is random each run.
#
# Important: do NOT include a trailing slash.
# Example: N8N_PUBLIC_URL=https://random.trycloudflare.com
N8N_PUBLIC_URL=
